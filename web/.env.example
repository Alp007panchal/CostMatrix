# Copy to .env.local and fill in from your Supabase project settings (API).
# Both values are public by design: they are sent to every browser. Row-level
# security is what protects the data, not the secrecy of these.
#
# The publishable key starts with sb_publishable_. Older projects have an "anon"
# key starting eyJ instead; if that is what your dashboard shows, put it in
# VITE_SUPABASE_ANON_KEY and the app will use it.
#
# The secret key (formerly the service role key) must NEVER appear in this file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
